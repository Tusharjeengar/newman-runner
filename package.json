{
  "name": "newman-runner",
  "version": "1.0.0",
  "description": "Desktop app to run Postman collections via Newman and view HTML reports",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "archiver": "^5.3.2",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "newman": "^6.1.0",
    "newman-reporter-htmlextra": "^1.23.1",
    "newman-reporter-json": "^1.0.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.team.newman-runner",
    "productName": "Newman Runner",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "server.js",
      "run-newman.js",
      "insights-engine.js",
      "assertion-generator.js",
      "public/**/*",
      "collections/**/*",
      "environments/**/*",
      "reports/**/*",
      "datafiles/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Newman Runner"
    },
    "portable": {
      "artifactName": "Newman-Runner-Portable.exe"
    }
  }
}
